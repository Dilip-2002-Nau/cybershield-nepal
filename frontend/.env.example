# CyberShield Nepal - Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# Backend API URL
# Default: http://localhost:5000/api (local development)
REACT_APP_API_URL=http://localhost:5001/api

# Environment mode
# Options: development, production
REACT_APP_ENV=development

# Enable debug logs (true/false)
REACT_APP_DEBUG=true

# Application name
REACT_APP_NAME=CyberShield Nepal

# Token storage key
REACT_APP_TOKEN_KEY=cybershield_token
